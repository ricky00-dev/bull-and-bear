# 복사해서 deploy/.env로 쓴다. deploy/.env는 커밋하지 않는다 (.gitignore)
# 비밀값 생성: openssl rand -hex 24

# 도메인을 넣으면 Caddy가 HTTPS 인증서를 자동으로 받는다. 도메인이 없으면 ":80" (HTTP만)
SITE_ADDRESS=:80

POSTGRES_PASSWORD=
# Spring ↔ 워커 내부 인증
WORKER_TOKEN=

# fake: 가짜 워커(시연 경로 확인용) / http: 실제 워커 (--profile worker 와 함께)
WORKER_MODE=fake
# 전향 운용(고정 종목 매일 토론). 실제 워커를 붙인 뒤 true
FORWARD_RUN_ENABLED=false

# 비용 상한. 전시 당일에는 올린다 (docs/ROADMAP.md 비용 계획)
BUDGET_USER_DAILY_USD=3.0
BUDGET_PER_USER_DAILY_DEBATES=5

# 워커용 키 (--profile worker 일 때만 필요)
ANTHROPIC_API_KEY=
DART_API_KEY=
KRX_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
