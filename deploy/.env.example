# 복사해서 deploy/.env로 쓴다. deploy/.env는 커밋하지 않는다 (.gitignore)
# 비밀값 생성: openssl rand -hex 24

# 도메인을 넣으면 Caddy가 HTTPS 인증서를 자동으로 받는다. 도메인이 없으면 ":80" (HTTP만)
SITE_ADDRESS=:80

POSTGRES_PASSWORD=
# Spring ↔ 워커 내부 인증
WORKER_TOKEN=

# fake: 가짜 워커(시연 경로 확인용) / http: 실제 워커 (--profile worker 와 함께)
WORKER_MODE=fake
# 전향 운용(고정 종목 매일 토론). 실제 워커를 붙인 뒤 true
FORWARD_RUN_ENABLED=false
# 실험 조건 B(단일 판정). 워커가 단일 모드(계약 v0.6)를 지원하면 true. 정식 운용(11/11) 전에 켠다
SINGLE_ENABLED=false

# Spring 입장 제한용 추정 예산. 요청별 확정 비용 예약은 아래 워커 장부를 사용한다.
BUDGET_USER_DAILY_USD=3.0
BUDGET_PER_USER_DAILY_DEBATES=5

# 실제 HTTP 워커의 영속 비용 제한(선택 사항, 예비 운용 전 설정 권장).
# 두 값을 함께 지정한다. 재시작/날짜 변경으로 초기화하지 않는 해당 데이터 볼륨의 총액이다.
# 기존 장부의 ID/금액을 바꾸면 시작을 거부한다. 빈 값은 이 장부가 적용되지 않음을 뜻한다.
WORKER_BUDGET_USD=
WORKER_BUDGET_ID=
WORKER_MAX_CONCURRENT=2

# 워커용 키 (--profile worker 일 때만 필요)
ANTHROPIC_API_KEY=
# 역할별 모델 (비우면 compose 기본값: 토론자·중재자 모두 Sonnet)
DEBATER_MODEL=claude-sonnet-5-5
MODERATOR_MODEL=claude-sonnet-5-5
DART_API_KEY=
KRX_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
